:8080 {
	# Zenoh's remote API, for zenoh-ts in the page; see zenoh-ws in compose.yaml.
	handle /zenoh {
		reverse_proxy {$ZENOH_WS:zenoh-ws:10000}
	}
	# Model and world files, and meshes as glTF; the map also reads the
	# world's georeference here.
	handle_path /models/* {
		reverse_proxy {$GZ_ASSETS:gz-assets:9003}
	}
	handle {
		root * /srv
		file_server
	}
}
